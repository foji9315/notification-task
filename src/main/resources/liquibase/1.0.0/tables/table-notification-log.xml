<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="notLogT" value="notification_log"/>

    <changeSet id="table-notification-log-0" author="${AuthorName}" >
        <preConditions onFail="MARK_RAN" onFailMessage="Notification_log table already exist">
            <not>
                <tableExists schemaName="${schemaName}" tableName="${notLogT}" />
            </not>
        </preConditions>
        <createTable schemaName="${schemaName}" tableName="${notLogT}">
            <column name="id" type="CHAR(36)" >
                <constraints primaryKey="true" primaryKeyName="pk_notification_id" nullable="false"/>
            </column>
            <column name="message_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="subscriber_id" type="CHAR(36)">
                <constraints nullable="false" />
            </column>
            <column name="channel_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="published" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="true" />
            </column>
            <column name="send_date" type="datetime2">
                <constraints nullable="true" />
            </column>
            <column name="subscriber_received_date" type="datetime2">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>
    <changeSet author="${AuthorName}" context="${ALL}" id="table-notification-log-1">
        <preConditions onFail="MARK_RAN" onFailMessage="Db does not support indexes">
            <not>
                <dbms type="h2"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="message_id"
                                 baseTableName="${tableName}"
                                 constraintName="fk_notification_message_id"
                                 referencedColumnNames="id"
                                 referencedTableName="posted_messages"/>
        <!-- <addForeignKeyConstraint baseColumnNames="subscriber_id"
                                 baseTableName="${tableName}"
                                 constraintName="fk_notification_subscriber_id"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/> -->
        <sql>CREATE INDEX IF NOT EXISTS notification_log_idx01 ON notification_log (subscriber_id, published)</sql>
        <sql>CREATE INDEX IF NOT EXISTS notification_log_idx02 ON notification_log (message_id)</sql>
        <sql>CREATE INDEX IF NOT EXISTS notification_log_idx03 ON notification_log USING HASH (LOWER(status))</sql>
    </changeSet>

</databaseChangeLog>